# cross-platform line-ending consistency for snapshots, scripts and
# dprint-managed text (Windows contributors work through WSL2; the Windows CI
# job checks out with native git where core.autocrlf=true, and dprint expects LF)
*.snap text eol=lf
*.sh text eol=lf
justfile text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
