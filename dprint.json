{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "markdown": {
    "textWrap": "maintain"
  },
  "toml": {
    "indentWidth": 2,
    "newLineKind": "auto",
    "cargo.applyConventions": false
  },
  "includes": ["**/*.md", "**/*.toml", "**/*.ts", "**/*.js", "**/*.mjs"],
  "excludes": [
    "CHANGELOG.md",
    "target/**",
    "**/node_modules/**",
    "packages/*/lib/**",
    ".direnv/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.23.2.wasm",
    "https://plugins.dprint.dev/toml-0.9.0.wasm",
    "https://plugins.dprint.dev/typescript-0.95.11.wasm"
  ]
}
