# The task layer: the single implementation site for every repeatable piece of
# automation in this repository. Local development, git hooks
# (.pre-commit-config.yaml) and CI (.github/workflows/) are all just callers.
# Rules: no version numbers here (reference the SSOT of the layer below); no
# bashisms or duplicated arguments in recipes — each tool's parameters live in
# that tool's own config file.

[windows]
set shell := ["powershell.exe", "-NoLogo", "-Command"]

export RUSTDOCFLAGS := "-D warnings"

# List all commands (just --list is living documentation)
default:
    @just --list

# Manual hook install for non-Nix shells — inside the devShell this happens
# automatically on entry (git cannot ship hooks with a clone). `--force`
# because prek owns every hook here: stale `<hook>.legacy` copies are removed
# instead of keeping the shim in migration mode.
setup:
    prek install --force --hook-type pre-commit --hook-type commit-msg

# In CI the pre-commit framework fails the job if files were modified by this
# (see the quality-gate job), so the check-mode twin is only exercised there.

# Install the locked JavaScript toolchain dependencies. Shared by lint/test/deny;
# just executes this dependency only once for a multi-recipe invocation.
_js-install:
    node scripts/check-node-version.mjs
    pnpm install --frozen-lockfile

# Format Rust (rustfmt) and Markdown/TOML/TypeScript (dprint; config: dprint.json) — write mode
fmt:
    cargo fmt --all
    dprint fmt

# The two ignored shellcheck codes are style hints from the dist-generated
# release.yml, which we must not hand-edit (drift check); accepted policy.
# No path argument: actionlint discovers .github/workflows/ itself, because
# the Windows shell (PowerShell) does not expand globs for native commands.

# Static checks: Rust, Markdown/TOML/TypeScript/JavaScript, TS types and workflow YAML
lint: _js-install
    cargo fmt --all -- --check
    dprint check
    # --all-targets unifies dev-only GPUI features; check the normal binary too.
    cargo check --bin metis
    cargo clippy --workspace --all-targets -- -D warnings
    pnpm --filter @metis/dsh-host typecheck
    actionlint -ignore 'SC2086' -ignore 'SC2129'

# Tests: compile the plugin before Rust's runtime tests, then run all Rust and JavaScript checks
test: _js-install
    pnpm --filter @metis/dsh-host test
    node --test scripts/check-js-licenses.test.mjs
    node --test scripts/prune-production.test.mjs
    cargo nextest run --workspace --all-targets
    cargo nextest run -p metis --no-default-features --test cli
    cargo test --doc --workspace

# Build a portable archive containing the headless Rust binary, Node.js, dsh and the Metis extension
headless-package: _js-install
    node scripts/package-headless.mjs

# Extract the latest headless archive and exercise Host, sessions and real Git without display libraries
headless-smoke: headless-package
    node scripts/smoke-headless.mjs

# Exercise a real Editor through isolated Wayland, Fcitx5, cross-process clipboard and native pixels
native-editor-smoke:
    node scripts/smoke-native-editor.mjs

# Run the same native Editor acceptance in an Ubuntu 24.04 Docker environment
native-editor-smoke-ubuntu:
    node scripts/smoke-native-editor-ubuntu.mjs

# Run opt-in Workbench performance acceptance on the preregistered reference runner
perf-workbench:
    cargo nextest run --release -p metis --test workbench_performance --run-ignored all -j 1

# Build docs (rustdoc warnings are errors; RUSTDOCFLAGS injected at the top of this file)
doc:
    cargo doc --no-deps --workspace

# Dependency policy: advisories / licenses / duplicate versions / sources (see deny.toml).
# All warnings are errors except missing Cargo license metadata, which can be absent
# even when a crate ships an accepted LICENSE file. Unlicensed crates and disallowed
# file-detected licenses still fail. Staleness fuses reject expired advisory, skip
# and per-crate license exceptions.
deny: _js-install
    cargo deny check -A no-license-field -D warnings -D advisory-not-detected -D yanked-not-detected -D index-failure -D license-exception-not-encountered -D gather-failure -D unmatched-skip -D unnecessary-skip
    pnpm audit
    pnpm licenses list --json | node scripts/check-js-licenses.mjs

# .github/workflows/release.yml is generated by `dist generate` — never
# hand-edit it; this recipe is the drift check (also a CI job).

# Drift check: fail if generated release.yml diverges from dist-workspace.toml
dist-check:
    dist generate --mode ci --check

# Snapshot review: approve diffs one by one; CI is read-only and never auto-accepts
snapshot-review:
    cargo insta review

# Smoke check for agent-facing docs: SKILL.md frontmatter, size budgets, and
# pointer integrity (AGENTS.md / CLAUDE.md / .claude/skills). Std-only Rust in
# crates/xtask; runs on every platform `just ci` runs on.
agent-check:
    cargo run -q -p xtask -- agent-check

# Bump rust-toolchain.toml's channel to the latest stable release. The weekly
# toolchain-update workflow wraps this in a validated PR; requires curl.
toolchain-bump:
    cargo run -q -p xtask -- bump-toolchain

# Secret scan of a PR's diff (added lines): token / private-key / .env shapes,
# hard fail. The pr-guard.yml workflow is the CI caller (needs gh + GH_TOKEN);
# `pr-guard --staged` is the local pre-commit half.
pr-guard pr="":
    cargo run -q -p xtask -- pr-guard {{ quote(pr) }}

# Core local quality gate; CI adds platform and hosting checks. The template
# repository additionally runs bootstrap smoke. pr-preflight also runs dist-check.
ci: lint test doc deny agent-check
    @echo "just ci: all green ✅"

# Add an internal crate (unpublished by default; rules in CONTRIBUTING.md "Adding a crate")
new-crate name:
    cargo run -q -p xtask -- new-crate {{ quote(name) }}
